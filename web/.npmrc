# Install `file:` dependencies (vendor/anvil) as real packages rather than
# symlinks. Two reasons:
#
# 1. Security. As a symlink, npm treats vendor/anvil like a workspace and
#    installs its *devDependencies* (storybook, eslint, jest, watch,
#    vite-plugin-node-polyfills, ...) into this lockfile. That dev tooling is
#    never run from this repo, but it dragged in every open Dependabot alert
#    on web/ — including `elliptic`, which has no patched release at all.
#    Root `overrides` cannot reach into a linked package's subtree, so the
#    only fix that does not edit vendor/anvil (see vendor/anvil/VENDORED.md:
#    "do not edit") is to stop installing those devDependencies.
#
# 2. Correctness. Nothing resolves anvil through node_modules anyway — the
#    app uses the `@dittolive/anvil` vite alias to vendor/anvil/src/index.ts
#    and a tsconfig `paths` entry to the type shim.
#
# Anvil's runtime `dependencies` are still installed; the app compiles anvil
# from source and needs them. Remove this file when anvil is swapped for the
# published npm package (VENDORED.md, "Swapping to the real npm package").
install-links=true
