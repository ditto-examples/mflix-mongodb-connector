{
  "name": "@dittolive/anvil",
  "version": "0.0.4",
  "description": "Anvil, Ditto's React design system.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/getditto/cloud-services.git",
    "directory": "anvil"
  },
  "author": "Dittolive Inc.",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": false,
  "main": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "dist",
    "LICENSE.md",
    "PUBLISHING.md",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./theme.css": "./dist/esm/theme.css",
    "./theme-config": {
      "types": "./dist/esm/theme-config.d.ts",
      "import": "./dist/esm/theme-config.js",
      "default": "./dist/esm/theme-config.js"
    },
    "./index.css": "./dist/esm/index.css",
    "./font/*": "./dist/esm/font/*"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "yarn clean && yarn build:types && yarn build:bundle && yarn build:assets",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "vite build",
    "build:assets": "node scripts/copy-assets.mjs",
    "check-types": "tsc --noemit -p tsconfig.json",
    "lint": "eslint --ext .tsx,.ts src && prettier --check src/**/*.{ts,tsx} && yarn check-types",
    "prettify": "eslint --ext .tsx,.ts src --fix && prettier src/**/*.{ts,tsx} --write",
    "clean": "rimraf -rf dist",
    "nuke": "rimraf -rf node_modules",
    "test": "jest",
    "pack:check": "yarn build && node scripts/check-package.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:watch": "watch 'yarn run build' src"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.1",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@headlessui/react": "^2.0.3",
    "@phosphor-icons/react": "^2.1.10",
    "@popperjs/core": "^2.11.8",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "=1.1.1",
    "@radix-ui/react-radio-group": "^1.2.1",
    "@radix-ui/react-select": "=2.1.1",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tailwindcss/forms": "^0.5.7",
    "@tanstack/react-table": "^8.17.3",
    "@uiw/codemirror-themes": "^4.23.10",
    "@uiw/react-codemirror": "^4.23.10",
    "class-variance-authority": "^0.6.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.11",
    "emblor": "^1.4.8",
    "object-hash": "^3.0.0",
    "overlayscrollbars": "^2.10.0",
    "overlayscrollbars-react": "^0.5.6",
    "prism-react-renderer": "^2.0.6",
    "prismjs": "^1.30.0",
    "react-day-picker": "^9.11.1",
    "react-dropzone": "^14.2.1",
    "react-hook-form": "^7.53.0",
    "react-portal": "^4.2.1",
    "react-resizable-panels": "^3.0.6",
    "react-transition-group": "^4.4.1",
    "react-virtual": "^2.10.4",
    "safe-stable-stringify": "^2.2.0",
    "sonner": "^2.0.4",
    "tailwind-merge": "^3.0.0",
    "uuid": "^14.0.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.12.10",
    "@babel/plugin-transform-runtime": "^7.12.10",
    "@babel/preset-env": "^7.12.11",
    "@babel/preset-react": "^7.12.10",
    "@babel/preset-typescript": "^7.12.7",
    "@babel/runtime": "^7.26.10",
    "@storybook/addon-docs": "10.3.6",
    "@storybook/addon-links": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.5.5",
    "@types/object-hash": "^3.0.6",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^18.0.12",
    "@types/react-dom": "^18.0.5",
    "@types/react-portal": "^4.0.2",
    "@types/testing-library__jest-dom": "^5.9.5",
    "@types/testing-library__react": "^10.2.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "babel-loader": "^8.2.2",
    "emotion-theming": "^11.0.0",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-loader": "^4.0.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.22.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "eslint-plugin-storybook": "^10.3.6",
    "file-loader": "^6.2.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "path": "^0.12.7",
    "prettier": "^3.3.3",
    "prettier-eslint": "^16.4.2",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "rimraf": "^3.0.2",
    "storybook": "^10.3.6",
    "style-loader": "^3.3.1",
    "tailwindcss": "^4.1.0",
    "tailwindcss-animate": "^1.0.7",
    "ts-loader": "^9.3.0",
    "ts-node": "^9.1.1",
    "typescript": "^5.9.2",
    "vite": "^8.1.4",
    "vite-plugin-commonjs": "^0.10.4",
    "vite-plugin-node-polyfills": "^0.28.0",
    "watch": "^1.0.2"
  },
  "peerDependencies": {
    "@sentry/browser": "^10.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.12.0"
  }
}
