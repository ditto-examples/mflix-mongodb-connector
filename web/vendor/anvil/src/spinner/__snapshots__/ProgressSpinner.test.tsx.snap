// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ProgressSpinner > should correctly render a progress spinner with completed progress 1`] = `
<div>
  <svg
    aria-valuemax="100"
    aria-valuemin="0"
    aria-valuenow="100"
    class="relative animate-pulse"
    fill="none"
    height="40"
    role="progressbar"
    viewBox="0 0 100 100"
    width="40"
    xmlns="http://www.w3.org/2000/svg"
  >
    <rect
      fill="transparent"
      height="100"
      rx="14"
      width="100"
    />
    <circle
      cx="50"
      cy="50"
      r="44"
      stroke="var(--color-progress-remaining)"
      stroke-width="12"
    />
    <circle
      cx="50"
      cy="50"
      r="44"
      stroke="var(--color-progress)"
      stroke-dasharray="276.46015351590177"
      stroke-dashoffset="0"
      stroke-linecap="round"
      stroke-width="12"
      transform="rotate(-90 50 50)"
    />
  </svg>
</div>
`;

