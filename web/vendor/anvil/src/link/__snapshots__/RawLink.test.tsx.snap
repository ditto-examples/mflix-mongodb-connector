// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`RawLink > should correctly render blank links with the noreferrer property 1`] = `
<div>
  <a
    class="cursor-pointer my-class-name"
    href="http://ditto.live"
    rel="noreferrer"
    target="_blank"
  >
    Child content
  </a>
</div>
`;

exports[`RawLink > should render an active link correctly. 1`] = `
<div>
  <a
    class="cursor-pointer my-class-name"
    data-discover="true"
    href="/internal"
  >
    Child content
  </a>
</div>
`;

