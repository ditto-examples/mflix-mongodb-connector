{
  "name": "rn-expo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "clean": "rm -rf node_modules android ios yarn.lock",
    "start": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "build:android": "expo prebuild --platform android && cd android && ./gradlew assembleRelease",
    "build:ios-sim": "expo prebuild --platform ios && cd ios && xcodebuild -workspace mflixexpo.xcworkspace -scheme mflixexpo -configuration Release -sdk iphonesimulator -destination 'platform=iOS Simulator,name=iPhone 16 Pro'",
    "build:ios-device": "expo prebuild --platform ios && cd ios && xcodebuild -workspace mflixexpo.xcworkspace -scheme mflixexpo -configuration Release -sdk iphoneos -archivePath build/mflixexpo.xcarchive archive",
    "build:ios": "npm run build:ios-sim",
    "build:release": "npm run build:android && npm run build:ios",
    "install:android": "adb install android/app/build/outputs/apk/release/app-release.apk",
    "install:android-all": "for device in $(adb devices | grep device | cut -f1); do adb -s $device install android/app/build/outputs/apk/release/app-release.apk; done",
    "install:ios-sim": "xcrun simctl install booted ios/build/Release-iphonesimulator/mflixexpo.app"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@dittolive/ditto": "^5.0.3",
    "@dittolive/ditto-react-native-tools": "^2.0.0",
    "@dr.pogodin/react-native-fs": "^2.39.2",
    "@expo/config-plugins": "~10.1.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.1.6",
    "@shopify/flash-list": "2.0.2",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-zip-archive": "^9.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "@tootallnate/once@<2.0.1": "2.0.1",
    "@xmldom/xmldom@<0.8.13": "0.8.13",
    "ajv@>=7.0.0-alpha.0 <8.18.0": "8.20.0",
    "brace-expansion@<1.1.18": "1.1.18",
    "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
    "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
    "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
    "form-data@>=4.0.0 <4.0.6": "4.0.6",
    "glob@>=10.2.0 <10.5.0": "10.5.0",
    "js-yaml@<3.15.1": "3.15.1",
    "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
    "lodash@<4.18.0": "4.18.1",
    "minimatch@<3.1.4": "3.1.5",
    "minimatch@>=9.0.0 <9.0.7": "9.0.9",
    "nanoid@<3.3.18": "3.3.18",
    "picomatch@<2.3.2": "2.3.2",
    "postcss@<8.5.23": "8.5.26",
    "shell-quote@<1.9.0": "1.10.0",
    "uuid@<11.1.1": "11.1.1",
    "ws@>=6.0.0 <6.2.4": "6.2.6",
    "ws@>=7.0.0 <7.5.11": "7.5.13",
    "ws@>=8.0.0 <8.21.0": "8.21.3"
  },
  "private": true
}
